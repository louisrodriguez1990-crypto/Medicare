# ── Site identity ────────────────────────────────────────────────────────────
SITE_URL=https://example.com
SITE_NAME=HCPCS Reimbursement
SITE_TAGLINE="Medicare HCPCS reimbursement rates by state, sourced from CMS."
PUBLISHER_NAME=HCPCS Reimbursement

# ── Data layer ───────────────────────────────────────────────────────────────
# Postgres (Neon or Supabase). Without it, the app falls back to seed fixtures.
DATABASE_URL=

# Upstash Redis (optional). Without it, requests skip the warm cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Build sizing ─────────────────────────────────────────────────────────────
SSG_TOP_N=1000
SITEMAP_TOP_N=200

# ── Monetization & analytics ─────────────────────────────────────────────────
# Google AdSense publisher ID (e.g. ca-pub-1234567890123456). Empty in dev.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Per-slot ad unit IDs from the AdSense dashboard
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_MID=
NEXT_PUBLIC_ADSENSE_SLOT_END=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=

# Google Search Console verification token (the part after content="")
GSC_VERIFICATION_TOKEN=

# ── Webhook ──────────────────────────────────────────────────────────────────
# HMAC secret for /api/revalidate
REVALIDATE_SECRET=replace-me
