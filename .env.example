# Postgres (Neon or Supabase) — required at runtime, optional in dev (falls back to fixtures)
DATABASE_URL=

# Upstash Redis — optional; if unset, requests skip the cache layer
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Site
SITE_URL=https://example.com

# Licensed agent E-E-A-T data (drives JSON-LD Person + footer)
AGENT_NAME="Jane Doe"
AGENT_NPN="1234567"
AGENT_LICENSED_STATES="TX,FL,CA,NY,PA"
AGENT_NIPR_URL="https://nipr.com/licensing-center/lookup-results?npn=1234567"
AGENT_STATE_DOI_URL="https://www.tdi.texas.gov/agent/lookup.html?npn=1234567"
AGENT_LINKEDIN_URL=

# CMS marketing identifier (rendered in footer)
CMS_MARKETING_ID="MULTIPLAN_XXXXXXXX_M"

# Revalidate webhook secret (HMAC)
REVALIDATE_SECRET=replace-me
